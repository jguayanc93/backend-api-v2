# Plantilla. Copiar como .env y completar con valores reales.
# El .env esta en .gitignore; este archivo NO, asi que aqui nunca van credenciales.
#
# Si una variable falta, se usa el valor que estaba escrito en conexion/cadena.js,
# de modo que sin .env el servicio sigue apuntando a produccion como siempre.

DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TIMEOUT=60000

# Tamano del pool de conexiones
DB_POOL_MAX=10
DB_POOL_ESPERA=20000

# Secreto con el que se firman y se verifican las cookies de sesion.
# Es el mismo en los dos lados (login/token.js firma, funciones/comunes/auth.js verifica).
# Si se cambia, todas las sesiones abiertas dejan de valer y hay que volver a entrar.
JWT_SECRET=

PORT=3000
